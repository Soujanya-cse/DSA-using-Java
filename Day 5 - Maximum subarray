class Solution {
    public int maxSubArray(int[] nums) {
        int maxValue=nums[0];
        int currentValue=0;

        for(int i=0;i<nums.length;i++){
            currentValue=currentValue + nums[i];

            if(currentValue>maxValue){
                maxValue=currentValue;
            }

            if(currentValue<0){
                currentValue=0;
            }
        }

        return maxValue;
    }
}
