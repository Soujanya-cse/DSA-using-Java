class Solution {
    public int maxProduct(int[] nums) {
        int answer=nums[0];
        int minAns=nums[0];
        int temp=nums[0];
        for(int i=1;i<nums.length;i++){
            
            if(nums[i]<0){
                int swap=answer;
                answer=minAns;
                minAns=swap;
            }

            answer=Math.max(nums[i],answer*nums[i]);
            minAns=Math.min(nums[i],minAns*nums[i]);

            if(answer>temp){
                temp=answer;
            }

        }

        return temp;
    }
}
