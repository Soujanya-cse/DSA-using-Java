class Solution {
    public int[] singleNumber(int[] nums) {
        int[] a=new int[2];
        HashMap<Integer,Integer> h=new HashMap<>();

        for(int i=0;i<nums.length;i++){
            if(h.containsKey(nums[i])){
                int count=h.get(nums[i]);
                count++;
                h.put(nums[i],count);
            }
            else{
                h.put(nums[i],1);
            }
        }

        int k=0;
        for(int i=0;i<nums.length;i++){
            if(h.get(nums[i])==1){
                a[k]=nums[i];
                k++;
            }
        }

        return a;
    }
}
